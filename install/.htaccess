# Noblogs — nessun accesso dal web.
#
# L'installer si lancia solo attraverso public/index.php (/install/),
# non richiedendo questo file.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>

Options -Indexes
